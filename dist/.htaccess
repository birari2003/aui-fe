<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Don't rewrite existing files or directories
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Route all non-file requests to index.php (PHP SPA router)
  # index.php handles OG tag injection for /showcase/ routes
  # and serves index.html as-is for all other SPA routes
  RewriteRule . /index.php [L]
</IfModule>
